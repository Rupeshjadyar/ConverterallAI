PORT=4000
NG_ALLOWED_HOSTS=converterallai.com,localhost,127.0.0.1
ANALYTICS_FILE=/app/data/analytics-live.json
# Optional. Generate a high-entropy token and store it in your deployment secret manager.
# Leave empty to disable the telemetry reset endpoint.
TELEMETRY_RESET_TOKEN=
# The optional hosted speech proxy requires python and edge-tts plus upstream access.
ENABLE_TTS_PROXY=false
